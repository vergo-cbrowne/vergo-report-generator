"use client";

import { useEffect, useRef, useState } from "react";
import {
  Upload,
  Clock,
  FileText,
  BookOpen,
  GraduationCap,
  LogOut,
  ChevronDown,
  ShieldCheck,
  Calendar,
  ExternalLink,
  Trash2,
  Menu,
  X,
  Sun,
  Moon,
  Eye,
  EyeOff,
  Lock,
  ArrowRight,
  Play,
  FileCheck,
  AlertTriangle,
} from "lucide-react";

const MAX_SIZE = 100 * 1024 * 1024;

export default function VergoClientPortal() {
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [profileOpen, setProfileOpen] = useState(false);
  const [lightMode, setLightMode] = useState(false);

  const [taskName, setTaskName] = useState("");
  const [siteLocation, setSiteLocation] = useState("");
  const [dateVideoTaken, setDateVideoTaken] = useState("");
  const [assessmentType, setAssessmentType] = useState("");
  const [taskDescription, setTaskDescription] = useState("");
  const [video, setVideo] = useState<File | null>(null);

  const [status, setStatus] = useState("");
  const [uploading, setUploading] = useState(false);
  const [uploadComplete, setUploadComplete] = useState(false);
  const [client, setClient] = useState<{ clientName: string; slug: string; email: string } | null>(null);
  const [loginEmail, setLoginEmail] = useState("");
  const [loginPassword, setLoginPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [authStatus, setAuthStatus] = useState("");
  const [loadingSession, setLoadingSession] = useState(true);
  const showSidebar = Boolean(client);

  const [currentPage, setCurrentPage] = useState<"upload" | "library">("upload");
  const [assessments, setAssessments] = useState<any[]>([]);
  const [loadingAssessments, setLoadingAssessments] = useState(false);
  const [deleteConfirmId, setDeleteConfirmId] = useState<string | null>(null);
  const [deleting, setDeleting] = useState(false);

  const isValid =
    client &&
    taskName &&
    siteLocation &&
    dateVideoTaken &&
    assessmentType &&
    taskDescription &&
    video;

  useEffect(() => {
    async function restoreSession() {
      try {
        const response = await fetch("/api/auth/session");
        if (!response.ok) {
          return;
        }

        const data = await response.json();
        if (data?.client) {
          setClient(data.client);
        }
      } catch (error) {
        console.error("Failed to restore session", error);
      } finally {
        setLoadingSession(false);
      }
    }

    restoreSession();
  }, []);

  useEffect(() => {
    if (client && currentPage === "library") {
      loadAssessments();
    }
  }, [client, currentPage]);

  async function loadAssessments() {
    setLoadingAssessments(true);
    try {
      const response = await fetch("/api/assessments/list");
      const data = await response.json();
      if (response.ok) {
        setAssessments(data.assessments || []);
      } else {
        console.error("Failed to load assessments:", data.error);
      }
    } catch (error) {
      console.error("Error loading assessments:", error);
    } finally {
      setLoadingAssessments(false);
    }
  }

  async function handleDeleteAssessment(assessmentId: string) {
    setDeleting(true);
    try {
      const response = await fetch("/api/assessments/delete", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ assessmentId }),
      });

      if (response.ok) {
        setAssessments(assessments.filter((a) => a.id !== assessmentId));
        setDeleteConfirmId(null);
      } else {
        const data = await response.json();
        console.error("Delete failed:", data.error);
      }
    } catch (error) {
      console.error("Error deleting assessment:", error);
    } finally {
      setDeleting(false);
    }
  }

  async function handleLogin() {
    setAuthStatus("");
    if (!loginEmail || !loginPassword) {
      setAuthStatus("Please provide both email and password.");
      return;
    }

    try {
      const response = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: loginEmail, password: loginPassword }),
      });

      const data = await response.json();
      if (!response.ok) {
        setAuthStatus(data.error || "Unable to log in.");
        return;
      }

      setClient(data.client);
      setLoginEmail("");
      setLoginPassword("");
      setAuthStatus("");
    } catch (error) {
      console.error(error);
      setAuthStatus("Unable to reach the login service.");
    }
  }

  async function handleLogout() {
    try {
      await fetch("/api/auth/logout", { method: "POST" });
    } catch (error) {
      console.error(error);
    }
    setClient(null);
    setAuthStatus("");
    setStatus("");
    setUploadComplete(false);
  }

  function handleVideo(file: File | null) {
    setStatus("");
    setUploadComplete(false);

    if (!file) return;

    if (!["video/mp4", "video/quicktime"].includes(file.type)) {
      setStatus("Please upload an MP4 or MOV file.");
      return;
    }

    if (file.size > MAX_SIZE) {
      setStatus("Video is over 100 MB. Please upload a 20–45 second clip or compress the file.");
      return;
    }

    setVideo(file);
  }

  async function submitUpload() {
    setStatus("");

    if (!client) {
      setStatus("Please log in before uploading.");
      return;
    }

    if (!isValid || !video) {
      setStatus("Please complete all required fields and upload a video.");
      return;
    }

    const formData = new FormData();
    if (client) {
      formData.append("clientEmail", client.email);
    }
    formData.append("taskName", taskName);
    formData.append("siteLocation", siteLocation);
    formData.append("dateVideoTaken", dateVideoTaken);
    formData.append("assessmentType", assessmentType);
    formData.append("taskDescription", taskDescription);
    formData.append("video", video);

    setUploading(true);

    const response = await fetch("/api/upload", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();
    setUploading(false);

    if (!response.ok) {
      setStatus(result.error || "Upload failed. Please try again.");
      return;
    }

    setUploadComplete(true);
    setStatus("Upload complete.");
  }

  const SidebarContent = () => (
    <>
      <div>
        <div className="mb-6 lg:mb-7">
          <img
            src="/assets/vergo-logo-white-transparent.png"
            alt="Vergo"
            className="w-32 sm:w-36 h-auto mb-2"
          />

        </div>

        <nav className="space-y-2.5">
          <button
            onClick={() => setCurrentPage("upload")}
            className={`w-full rounded-xl px-4 py-3 flex items-center gap-3 transition ${
              currentPage === "upload"
                ? "border border-[#00c853] text-white bg-[#00c853]/10"
                : "text-zinc-200 hover:bg-white/5"
            }`}
          >
            <Upload size={21} className={currentPage === "upload" ? "text-[#00c853]" : ""} />
            <span className="text-sm sm:text-base">Upload New Assessment</span>
          </button>

          <button
            onClick={() => setCurrentPage("library")}
            className={`w-full rounded-xl px-4 py-3 flex items-center gap-3 transition ${
              currentPage === "library"
                ? "border border-[#00c853] text-white bg-[#00c853]/10"
                : "text-zinc-200 hover:bg-white/5"
            }`}
          >
            <Clock size={21} className={currentPage === "library" ? "text-[#00c853]" : ""} />
            <span className="text-sm sm:text-base">Assessment Library</span>
          </button>

          <a
            href="https://coda.io/d/Vergo-Guide-and-Documents_d6p0qGhIgSL/Video-Upload-Assessment-Guide_sugPlHrk#_luGE89v1"
            target="_blank"
            rel="noopener noreferrer"
            className="w-full text-zinc-200 rounded-xl px-4 py-3 flex items-center gap-3 hover:bg-white/5 transition"
          >
            <FileText size={21} />
            <ExternalLink size={15} className="ml-auto text-zinc-400" />
          </a>

          <a
            href="https://coda.io/d/Vergo-Guide-and-Documents_d6p0qGhIgSL/Getting-Started-with-Vergo_suhIVx8U#_luenbGgu"
            target="_blank"
            rel="noopener noreferrer"
            className="w-full text-zinc-200 rounded-xl px-4 py-3 flex items-center gap-3 hover:bg-white/5 transition"
          >
            <BookOpen size={21} />
            <span className="text-sm sm:text-base">Guides & Documents</span>
            <ExternalLink size={15} className="ml-auto text-zinc-400" />
          </a>

          <a
            href="https://coda.io/@vergo/vergo-futureproof-training-program"
            target="_blank"
            rel="noopener noreferrer"
            className="w-full text-zinc-200 rounded-xl px-4 py-3 flex items-center gap-3 hover:bg-white/5 transition"
          >
            <GraduationCap size={21} />
            <span className="text-sm sm:text-base">Training Modules</span>
            <ExternalLink size={15} className="ml-auto text-zinc-400" />
          </a>
        </nav>
      </div>

      <div className="mt-auto mb-3 px-1 flex items-center justify-between">
        <div className="flex items-center gap-3 text-zinc-200">
          {lightMode ? <Sun size={18} /> : <Moon size={18} />}
          <span className="text-sm">{lightMode ? "Light mode" : "Dark mode"}</span>
        </div>

        <button
          onClick={() => setLightMode(!lightMode)}
          className={`relative h-6 w-11 rounded-full transition ${
            lightMode ? "bg-[#00c853]" : "bg-zinc-700"
          }`}
          aria-label="Toggle light mode"
        >
          <span
            className={`absolute top-1 h-4 w-4 rounded-full bg-white transition ${
              lightMode ? "left-6" : "left-1"
            }`}
          />
        </button>
      </div>

      <div className="relative mt-2">
        <button
          onClick={() => setProfileOpen(!profileOpen)}
          className="w-full border border-white/10 rounded-xl p-3 flex items-center justify-between bg-white/[0.02] hover:bg-white/[0.04] transition"
        >
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-full border border-[#00c853] text-[#00c853] flex items-center justify-center font-semibold text-sm">
              VC
            </div>
            <div className="text-left">
              <div className="text-base">{client ? client.clientName : "Vergo Client"}</div>
              <div className="text-xs text-zinc-400">{client ? client.email : "client@vergo.ai"}</div>
            </div>
          </div>
          <ChevronDown size={17} />
        </button>

        {profileOpen && (
          <button
            onClick={handleLogout}
            className="w-full mt-0 border border-white/10 border-t-0 rounded-b-xl p-3 flex items-center gap-3 bg-white/[0.04] hover:bg-white/[0.07] transition"
          >
            <LogOut size={20} />
            <span className="text-base">{client ? "Log Out" : "Close"}</span>
          </button>
        )}
      </div>
    </>
  );

  return (
    <div className="min-h-screen bg-[#050708] text-white font-[Helvetica_Neue,Helvetica,Arial,sans-serif]">
      {showSidebar && (
        <>
          <div className="lg:hidden sticky top-0 z-40 border-b border-white/10 bg-[#050708]/95 backdrop-blur px-5 py-4 flex items-center justify-between">
            <img
              src="/assets/vergo-logo-white-transparent.png"
              alt="Vergo"
              className="w-28 h-auto"
            />
            <button
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              className="rounded-lg border border-white/10 p-2"
            >
              {mobileMenuOpen ? <X size={22} /> : <Menu size={22} />}
            </button>
          </div>

          {mobileMenuOpen && (
            <div className="lg:hidden border-b border-white/10 bg-[#050708] px-5 py-5">
              <SidebarContent />
            </div>
          )}
        </>
      )}

      <div className={`${showSidebar ? "flex" : "flex justify-center"}`}>
        {showSidebar && (
          <aside className="hidden lg:flex w-[300px] h-screen border-r border-white/10 bg-[#050708] px-5 py-6 flex-col justify-between overflow-hidden sticky top-0">
            <SidebarContent />
          </aside>
        )}

        <main
          className={`flex-1 ${showSidebar ? "" : "max-w-2xl mx-auto"} px-5 sm:px-7 lg:px-10 xl:px-12 py-8 sm:py-10 lg:py-12 transition-colors ${
            lightMode
              ? "bg-[#f7f8f7] text-zinc-950 [&_.text-zinc-300]:text-zinc-700 [&_.text-zinc-400]:text-zinc-600 [&_input]:!bg-white [&_textarea]:!bg-white [&_select]:!bg-white [&_input]:!text-zinc-950 [&_textarea]:!text-zinc-950 [&_select]:!text-zinc-950 [&_input]:!border-zinc-300 [&_textarea]:!border-zinc-300 [&_select]:!border-zinc-300"
              : "bg-[radial-gradient(circle_at_70%_20%,rgba(0,200,83,0.08),transparent_35%),#050708] text-white"
          }`}
        >
          <div className="max-w-[1400px] mx-auto">
            {showSidebar && currentPage === "upload" && (
            <header className={`border-b pb-7 sm:pb-8 mb-8 sm:mb-10 ${lightMode ? "border-zinc-200" : "border-white/10"}`}>
              <div className="text-[#00c853] text-sm sm:text-base font-bold tracking-[0.18em] uppercase mb-4">
                Client Portal
              </div>
              <h1 className="text-3xl sm:text-4xl lg:text-[44px] font-light tracking-[-0.02em] mb-4 font-['Helvetica_Neue',Helvetica,Arial,sans-serif]">
                Upload Task Video
              </h1>
              <p className="text-base sm:text-lg text-zinc-300 max-w-4xl">
                Upload a task video and provide the context Vergo needs to generate a movement analysis report.
              </p>
            </header>
          )}

            {showSidebar && currentPage === "library" && (
            <header className={`border-b pb-7 sm:pb-8 mb-8 sm:mb-10 ${lightMode ? "border-zinc-200" : "border-white/10"}`}>
              <div className="text-[#00c853] text-sm sm:text-base font-bold tracking-[0.18em] uppercase mb-4">
                Client Portal
              </div>
              <h1 className="text-3xl sm:text-4xl lg:text-[44px] font-light tracking-[-0.02em] mb-4 font-['Helvetica_Neue',Helvetica,Arial,sans-serif]">
                Assessment Library
              </h1>
              <p className="text-base sm:text-lg text-zinc-300 max-w-4xl">
                View completed assessments, download reports, and manage your assessment history.
              </p>
            </header>
          )}

            {loadingSession && (
              <section className={`rounded-2xl border p-5 sm:p-7 lg:p-8 transition-colors ${
                lightMode ? "border-zinc-200 bg-white shadow-sm" : "border-white/10 bg-white/[0.025]"
              }`}>
                <div className="py-20 text-center text-lg text-zinc-400">Checking your login session…</div>
              </section>
            )}

            {!loadingSession && !client && (
              <section className="rounded-3xl border border-zinc-200 bg-white shadow-[0_30px_80px_rgba(0,0,0,0.25)] p-6 sm:p-8 lg:p-10">
                <div className="max-w-xl mx-auto text-zinc-950">
                  <div className="flex flex-col items-center text-center gap-6 mb-10">
                    <img
                      src="/assets/vergo-logo.png"
                      alt="Vergo logo"
                      className="w-32 sm:w-36 h-auto"
                    />
                    <div>
                      <h2 className="text-3xl sm:text-4xl lg:text-[44px] font-light tracking-[-0.02em] mb-4 font-['Helvetica_Neue',Helvetica,Arial,sans-serif]">
                        Client Portal Login
                      </h2>
                      <p className="text-base sm:text-lg text-zinc-600 max-w-2xl mx-auto">
                        Sign in with your client email and password to access the Vergo upload portal.
                      </p>
                    </div>
                  </div>

                  <div className="grid gap-6">
                    <div>
                      <label className="block text-sm sm:text-base mb-2 text-zinc-800">Client Email</label>
                      <input
                        value={loginEmail}
                        onChange={(e) => setLoginEmail(e.target.value)}
                        type="email"
                        placeholder="you@example.com"
                        className="w-full rounded-2xl border border-zinc-300 bg-white px-4 py-4 text-sm sm:text-base text-zinc-950 outline-none placeholder:text-zinc-400 focus:border-[#00c853] focus:ring-2 focus:ring-[#00c853]/20"
                      />
                    </div>

                    <div>
                      <label className="block text-sm sm:text-base mb-2 text-zinc-800">Password</label>
                      <div className="relative">
                        <input
                          value={loginPassword}
                          onChange={(e) => setLoginPassword(e.target.value)}
                          type={showPassword ? "text" : "password"}
                          placeholder="Password"
                          className="w-full rounded-2xl border border-zinc-300 bg-white px-4 py-4 pr-12 text-sm sm:text-base text-zinc-950 outline-none placeholder:text-zinc-400 focus:border-[#00c853] focus:ring-2 focus:ring-[#00c853]/20"
                        />
                        <button
                          type="button"
                          onClick={() => setShowPassword(!showPassword)}
                          className="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-900"
                          aria-label={showPassword ? "Hide password" : "Show password"}
                        >
                          {showPassword ? <EyeOff size={20} /> : <Eye size={20} />}
                        </button>
                      </div>
                    </div>

                    {authStatus && (
                      <div className="rounded-2xl border border-orange-500/40 bg-orange-500/10 px-4 py-3 text-sm text-orange-700">
                        {authStatus}
                      </div>
                    )}

                    <div className="flex flex-col items-center gap-4">
                      <button
                        onClick={handleLogin}
                        className="inline-flex items-center justify-center gap-3 rounded-2xl border border-[#00c853]/60 bg-white px-8 py-4 text-base sm:text-lg font-semibold text-zinc-950 shadow-[0_0_0_0_rgba(0,200,83,0)] transition duration-300 hover:shadow-[0_0_30px_rgba(0,200,83,0.18)] hover:bg-[#f6fff7] focus:outline-none"
                      >
                        <Lock size={18} className="text-zinc-950" />
                        <span>Sign in</span>
                        <ArrowRight size={18} className="text-zinc-950" />
                      </button>
                      <p className="text-sm text-zinc-600 max-w-md leading-6">
                        Having trouble logging in? <br />
                        Please reach out to <a href="mailto:support@vergo.ai" className="font-semibold text-[#00c853]">support@vergo.ai</a>.
                      </p>
                    </div>
                  </div>
                </div>
              </section>
            )}

            {client && currentPage === "upload" && (
              <section className={`rounded-2xl border p-5 sm:p-7 lg:p-8 transition-colors ${
                lightMode ? "border-zinc-200 bg-white shadow-sm" : "border-white/10 bg-white/[0.025]"
              }`}>
              <div className="flex justify-start sm:justify-end mb-6">
                <div className="flex items-center gap-3 text-zinc-300 text-sm sm:text-base">
                  <FileText size={18} />
                  <span>Max file size:</span>
                  <span className="text-[#00c853]">100 MB</span>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 sm:gap-6 lg:gap-8 mb-7">
                <div>
                  <label className="block text-sm sm:text-base mb-2">
                    Task Name <span className="text-orange-500">*</span>
                  </label>
                  <input
                    value={taskName}
                    onChange={(e) => setTaskName(e.target.value)}
                    placeholder="e.g. Material Handling Task"
                    className="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3 sm:py-4 text-sm sm:text-base outline-none focus:border-[#00c853]"
                  />
                </div>

                <div>
                  <label className="block text-sm sm:text-base mb-2">
                    Site / Location <span className="text-orange-500">*</span>
                  </label>
                  <input
                    value={siteLocation}
                    onChange={(e) => setSiteLocation(e.target.value)}
                    placeholder="e.g. Work Area or Department"
                    className="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3 sm:py-4 text-sm sm:text-base outline-none focus:border-[#00c853]"
                  />
                </div>

                <div>
                  <label className="block text-sm sm:text-base mb-2">
                    Date Video Taken <span className="text-orange-500">*</span>
                  </label>
                  <div className="relative">
                    <input
                      type="date"
                      value={dateVideoTaken}
                      onChange={(e) => setDateVideoTaken(e.target.value)}
                      className="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3 sm:py-4 text-sm sm:text-base outline-none focus:border-[#00c853]"
                    />
                    <Calendar className="absolute right-4 top-3.5 sm:top-4 text-zinc-300 pointer-events-none" size={21} />
                  </div>
                </div>
              </div>

              <div className="mb-7">
                <label className="block text-sm sm:text-base mb-2">
                  Assessment Type <span className="text-orange-500">*</span>
                </label>
                <select
                  value={assessmentType}
                  onChange={(e) => setAssessmentType(e.target.value)}
                  className="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3 sm:py-4 text-sm sm:text-base outline-none focus:border-[#00c853]"
                >
                  <option value="">Select assessment type</option>
                  <option value="REBA">REBA</option>
                  <option value="RULA">RULA</option>
                  <option value="Not Sure">Not Sure</option>
                </select>

                <div className="mt-4 sm:mt-5 text-zinc-300 leading-7 sm:leading-8 text-sm sm:text-base">
                  <div>Choose <span className="text-[#00c853] font-semibold">REBA</span> for full-body tasks like lifting, bending, pushing, pulling, or carrying.</div>
                  <div>Choose <span className="text-[#00c853] font-semibold">RULA</span> for upper-body or repetitive tasks involving the arms, wrists, shoulders, neck, or seated work.</div>
                  <div>Select <span className="text-[#00c853] font-semibold">Not Sure</span> if you are not certain which assessment type is most appropriate.</div>
                </div>
              </div>

              <div className="mb-7">
                <div className="flex items-center justify-between mb-3">
                  <label className="block text-base sm:text-lg">
                    Task Description <span className="text-orange-500">*</span>
                  </label>
                  <span className="text-zinc-400 text-sm">{taskDescription.length} / 1000</span>
                </div>
                <textarea
                  value={taskDescription}
                  onChange={(e) => setTaskDescription(e.target.value.slice(0, 1000))}
                  placeholder="Describe the task, movement patterns, work conditions, tools used, frequency, awkward postures, or worker concerns."
                  rows={4}
                  className="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3 sm:py-4 text-sm sm:text-base outline-none focus:border-[#00c853]"
                />
              </div>

              <div className="mb-7">
                <label className="block text-sm sm:text-base mb-2">
                  Assessment Video <span className="text-orange-500">*</span>
                </label>

                <input
                  ref={fileInputRef}
                  type="file"
                  accept=".mp4,.mov,video/mp4,video/quicktime"
                  className="hidden"
                  onChange={(e) => handleVideo(e.target.files?.[0] || null)}
                />

                <button
                  type="button"
                  onClick={() => fileInputRef.current?.click()}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={(e) => {
                    e.preventDefault();
                    handleVideo(e.dataTransfer.files?.[0] || null);
                  }}
                  className={`w-full border border-dashed rounded-xl p-6 sm:p-8 lg:p-10 flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8 lg:gap-10 hover:border-[#00c853] hover:bg-[#00c853]/5 transition text-center sm:text-left ${
                  lightMode ? "border-zinc-300 bg-zinc-50" : "border-white/20"
                }`}
                >
                  <div className="w-20 h-20 sm:w-24 sm:h-24 rounded-full border border-[#00c853]/60 flex items-center justify-center flex-shrink-0">
                    <Upload size={36} className="text-[#00c853]" />
                  </div>
                  <div>
                    <div className="text-lg sm:text-xl mb-2">Drag and drop your video file here</div>
                    <div className="text-sm sm:text-base mb-3">
                      or <span className="text-[#00c853]">browse files</span>
                    </div>
                    <div className="text-zinc-400 text-sm sm:text-base">
                      MP4 or MOV <span className="text-[#00c853] mx-2 sm:mx-3">•</span> Max 100 MB <span className="text-[#00c853] mx-2 sm:mx-3">•</span> 20–45 seconds recommended
                    </div>
                  </div>
                </button>
              </div>

              {video && (
                <div className={`mb-7 rounded-lg border px-4 sm:px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${
                  lightMode ? "border-zinc-200 bg-zinc-50" : "border-white/10 bg-black/25"
                }`}>
                  <div className="flex items-center gap-4 min-w-0">
                    <FileText size={22} className="flex-shrink-0" />
                    <div className="min-w-0">
                      <div className="text-sm sm:text-base truncate">{video.name}</div>
                      <div className="text-zinc-400">{(video.size / 1024 / 1024).toFixed(1)} MB</div>
                    </div>
                  </div>

                  <div className="flex items-center gap-5">
                    {uploadComplete && <span className="text-[#00c853]">Upload complete</span>}
                    <button
                      onClick={() => {
                        setVideo(null);
                        setUploadComplete(false);
                      }}
                      className="text-zinc-400 hover:text-white"
                    >
                      <Trash2 size={22} />
                    </button>
                  </div>
                </div>
              )}

              {uploading && (
                <div className={`mb-7 rounded-xl border p-5 sm:p-6 ${
                  lightMode ? "border-zinc-200 bg-zinc-50" : "border-white/10 bg-black/25"
                }`}>
                  <div className="flex items-center gap-5">
                    <div className="h-12 w-12 rounded-full border-2 border-white/10 border-t-[#00c853] animate-spin" />
                    <div>
                      <div className="text-sm sm:text-base mb-1">Uploading video to Vergo...</div>
                      <div className="text-zinc-400 text-sm">Please keep this page open until the upload is complete.</div>
                    </div>
                  </div>
                </div>
              )}

              {status && (
                <div className={`mb-7 rounded-xl border px-5 py-4 ${
                  uploadComplete
                    ? "border-[#00c853]/40 text-[#00c853] bg-[#00c853]/5"
                    : "border-orange-500/40 text-orange-300 bg-orange-500/5"
                }`}>
                  {status}
                </div>
              )}

              <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div className="flex items-start gap-3 text-zinc-400 max-w-xl text-sm sm:text-base">
                  <ShieldCheck size={22} className="text-[#00c853] mt-1 flex-shrink-0" />
                  <p>Videos are securely uploaded and stored by Vergo and used only for ergonomic assessment reporting.</p>
                </div>

                <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-6">
                  <button className="text-white hover:text-zinc-300 py-3">Cancel</button>
                  <button
                    onClick={submitUpload}
                    disabled={!isValid || uploading}
                    className="rounded-lg bg-[#00c853] px-6 sm:px-8 py-4 text-base sm:text-lg font-semibold text-white flex items-center justify-center gap-3 hover:bg-[#00b84d] disabled:bg-zinc-700 disabled:text-zinc-400 transition"
                  >
                    <Upload size={22} />
                    {uploading ? "Uploading..." : "Upload"}
                  </button>
                </div>
              </div>
            </section>
            )}

            {client && currentPage === "library" && (
              <section className={`transition-colors ${
                lightMode ? "bg-[#f7f8f7] text-zinc-950" : "bg-[#050708]"
              }`}>
                {loadingAssessments ? (
                  <div className={`rounded-2xl border p-5 sm:p-7 lg:p-8 transition-colors ${
                    lightMode ? "border-zinc-200 bg-white shadow-sm" : "border-white/10 bg-white/[0.025]"
                  }`}>
                    <div className="py-20 text-center text-lg text-zinc-400">Loading assessments…</div>
                  </div>
                ) : assessments.length === 0 ? (
                  <div className={`rounded-2xl border p-5 sm:p-7 lg:p-8 transition-colors ${
                    lightMode ? "border-zinc-200 bg-white shadow-sm" : "border-white/10 bg-white/[0.025]"
                  }`}>
                    <div className="py-12 text-center text-lg text-zinc-400">
                      No assessments yet. Upload your first video to get started.
                    </div>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {assessments.map((assessment) => (
                      <div
                        key={assessment.id}
                        className={`rounded-2xl border overflow-hidden transition ${
                          lightMode
                            ? "border-zinc-200 bg-white shadow-sm hover:shadow-md"
                            : "border-white/10 bg-white/[0.025] hover:bg-white/[0.04]"
                        }`}
                      >
                        {/* Thumbnail */}
                        {assessment.thumbnail ? (
                          <img
                            src={assessment.thumbnail}
                            alt={assessment.task}
                            className="w-full h-48 object-cover"
                          />
                        ) : (
                          <div className={`w-full h-48 flex items-center justify-center ${
                            lightMode ? "bg-zinc-100" : "bg-white/[0.05]"
                          }`}>
                            <FileCheck size={40} className={lightMode ? "text-zinc-300" : "text-zinc-600"} />
                          </div>
                        )}

                        {/* Card Content */}
                        <div className="p-4 sm:p-5">
                          <div className="mb-2 flex items-center justify-between gap-2">
                            <h3 className={`text-base sm:text-lg font-semibold truncate ${
                              lightMode ? "text-zinc-900" : "text-white"
                            }`}>
                              {assessment.task}
                            </h3>
                            <span className={`inline-flex px-3 py-1 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap ${
                              assessment.assessmentType === "REBA"
                                ? "bg-[#00c853]/15 text-[#00c853]"
                                : "bg-blue-500/15 text-blue-400"
                            }`}>
                              {assessment.assessmentType}
                            </span>
                          </div>

                          <p className={`text-sm mb-4 ${lightMode ? "text-zinc-600" : "text-zinc-400"}`}>
                            {new Date(assessment.date).toLocaleDateString("en-US", {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                            })}
                          </p>

                          {/* Action Buttons */}
                          <div className="flex flex-col sm:flex-row gap-2">
                            <a
                              href={assessment.webViewLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              className="flex-1 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold bg-[#00c853] text-white hover:bg-[#00b84d] transition"
                            >
                              <FileCheck size={16} />
                              Open Report
                            </a>
                            <button
                              onClick={() => window.open(assessment.webViewLink)}
                              className={`flex-1 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition ${
                                lightMode
                                  ? "border border-zinc-300 text-zinc-900 hover:bg-zinc-50"
                                  : "border border-white/15 text-zinc-200 hover:bg-white/[0.05]"
                              }`}
                            >
                              <Play size={16} />
                              View Video
                            </button>
                          </div>

                          {/* Delete Button */}
                          <button
                            onClick={() => setDeleteConfirmId(assessment.id)}
                            className={`w-full mt-2 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition ${
                              lightMode
                                ? "border border-orange-300 text-orange-600 hover:bg-orange-50"
                                : "border border-orange-500/30 text-orange-400 hover:bg-orange-500/10"
                            }`}
                          >
                            <Trash2 size={16} />
                            Delete
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {/* Delete Confirmation Modal */}
                {deleteConfirmId && (
                  <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                    <div className={`rounded-2xl max-w-md w-full p-6 sm:p-8 ${
                      lightMode ? "bg-white text-zinc-900" : "bg-[#050708] border border-white/10 text-white"
                    }`}>
                      <div className="flex items-center gap-3 mb-4">
                        <AlertTriangle size={24} className="text-orange-500" />
                        <h2 className="text-xl sm:text-2xl font-semibold">Delete Assessment?</h2>
                      </div>
                      <p className={`mb-6 text-sm sm:text-base ${lightMode ? "text-zinc-600" : "text-zinc-400"}`}>
                        This will permanently remove the assessment video, report, and metadata. This action cannot be undone.
                      </p>
                      <div className="flex gap-3">
                        <button
                          onClick={() => setDeleteConfirmId(null)}
                          className={`flex-1 rounded-lg px-4 py-3 font-semibold transition ${
                            lightMode
                              ? "bg-zinc-100 text-zinc-900 hover:bg-zinc-200"
                              : "bg-white/[0.05] text-white hover:bg-white/[0.1]"
                          }`}
                        >
                          Cancel
                        </button>
                        <button
                          onClick={() => handleDeleteAssessment(deleteConfirmId)}
                          disabled={deleting}
                          className="flex-1 rounded-lg px-4 py-3 font-semibold bg-orange-600 text-white hover:bg-orange-700 disabled:bg-zinc-600 transition"
                        >
                          {deleting ? "Deleting..." : "Delete Assessment"}
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </section>
            )}
          </div>
        </main>
      </div>
    </div>
  );
}
